# Kết nối PostgreSQL (nên dùng chung 1 database với các module khác của BHXH PRO)
DATABASE_URL=postgres://user:password@localhost:5432/bhxh_pro

# Bí mật ký JWT cho phiên đăng nhập admin — đổi giá trị này khi triển khai thật
JWT_SECRET=change-me-to-a-long-random-string

# Cổng chạy server
PORT=3000

# Thời hạn token đăng nhập admin (đơn vị: giây), mặc định 12 giờ
ADMIN_TOKEN_TTL_SECONDS=43200
